<Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets"/>
<Target Name="BuildNoonInnoSetup" AfterTargets="Build" Condition="'$(NoonEnableInnoSetup)'=='true'">
<MSBuild Projects="$(ProjectDir)..\MfcEdgeDemo.vcxproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);Platform=x64"><Output TaskParameter="TargetOutputs" ItemName="NoonMainExe"/></MSBuild>
