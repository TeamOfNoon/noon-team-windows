<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
<ItemGroup Label="ProjectConfigurations"><ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration><ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration></ItemGroup>
<PropertyGroup Label="Globals"><ProjectGuid>{B7C24A7A-B7A3-4A7B-891B-F4B39B271822}</ProjectGuid><Keyword>Win32Proj</Keyword><RootNamespace>NoonInnoSetup</RootNamespace><WindowsTargetPlatformVersion>10.0.19041.0</WindowsTargetPlatformVersion></PropertyGroup>
<Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props"/>
<PropertyGroup Label="Configuration"><ConfigurationType>Utility</ConfigurationType><PlatformToolset>v142</PlatformToolset></PropertyGroup>
<Import Project="$(VCTargetsPath)\Microsoft.Cpp.props"/>
<Import Project="..\ProductInfo.props"/>
<Import Project="InnoSetupSettings.props"/>
<PropertyGroup><NoonEnableInnoSetup Condition="'$(NoonEnableInnoSetup)'==''">false</NoonEnableInnoSetup><OutDir>$(ProjectDir)bin\$(Platform)\$(Configuration)\</OutDir><IntDir>$(ProjectDir)obj\$(Platform)\$(Configuration)\</IntDir></PropertyGroup>
<ItemGroup><None Include="Noon.iss"/><None Include="BuildInnoSetup.ps1"/><None Include="InnoSetupSettings.props"/><None Include="README_INNO_SETUP.txt"/></ItemGroup>
