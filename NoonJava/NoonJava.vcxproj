  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- Wildcards are build-time inputs only; IDE project items above are explicit. -->
  <Target Name="CollectNoonJavaInputs">
    <ItemGroup>
      <NoonJavaBuildInput Include="$(ProjectDir)src\*.java;$(ProjectDir)resources\**\*;$(ProjectDir)lib\*.jar;$(ProjectDir)native-config\*.json;$(ProjectDir)tools\CompileDesktop.java;$(ProjectDir)BUILD_HTTP_DLL.bat" />
    </ItemGroup>
  </Target>
  <Target Name="CheckNoonToolchain" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Platform)'!='x64'" Text="NoonJava requires x64." />
    <Error Condition="!Exists('$(NoonGraalVMHome)\bin\native-image.cmd')" Text="Set NoonGraalVMHome in BuildSettings.props to your GraalVM installation." />
  </Target>
  <Target Name="PrepareNoonSigningKey" DependsOnTargets="CheckNoonToolchain">
    <Exec Command="call &quot;$(ProjectDir)..\PREPARE_SIGNING_KEY.bat&quot; &quot;$(NoonGraalVMHome)&quot;" />
  </Target>
  <Target Name="BuildNoonJavaDll" BeforeTargets="PrepareForBuild" DependsOnTargets="PrepareNoonSigningKey;CollectNoonJavaInputs"
    Inputs="@(NoonJavaBuildInput);$(ProjectDir)..\BuildSettings.props;$(MSBuildProjectFullPath)"
    Outputs="$(ProjectDir)dist\NoonJava.dll;$(ProjectDir)dist\NoonJava.h;$(ProjectDir)dist\graal_isolate.h">
    <Exec Command="call &quot;$(ProjectDir)BUILD_HTTP_DLL.bat&quot; &quot;$(NoonGraalVMHome)&quot; &quot;$(VSInstallDir)&quot;" />
  </Target>
  <!-- The VC build logger keeps $(IntDir)NoonJava.log open during Clean.
       Remove only generated Java/native outputs, never the build/log parent. -->
  <Target Name="CleanNoonJava" AfterTargets="Clean">
    <RemoveDir Directories="$(ProjectDir)build\classes;$(ProjectDir)build\nttool;$(ProjectDir)build\signing;$(ProjectDir)build\verify;$(ProjectDir)dist" />
  </Target>
</Project>
